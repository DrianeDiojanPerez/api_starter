# Server Configuration
APP_PORT=3000

# Deployment Configuration
APP_NAME="App_sample"
APP_ENVIRONMENT="DEVELOPMENT"
APP_TIMEZONE="America/Belize"

# Database Configuration
DB_HOST="database"
DB_PORT=5432
DB_DATABASE="api_starter"
DB_USERNAME="postgres"
DB_PASSWORD="password"
DB_MAX_CONNECTIONS=10

# Mailer Configuration
MAIL_HOST="mail"
MAIL_PORT=1025
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="API Starter"

# JWT Configuration
JWT_SECRET="secret"

# Authentication Configuration
AUTHENTICATION_ACCESS_TOKEN_TTL_SECONDS=3600
AUTHENTICATION_REFRESH_TOKEN_TTL_SECONDS=604800

# Logger Configuration
# Accepts a tracing level (trace|debug|info|warn|error) or the numeric slog
# level the Go service used (-4|0|4|8).
LOGGER_LEVEL=0
LOGGER_DIRECTORY="storage/logs"
