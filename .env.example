# Server Configuration
APP_PORT=3000

# Deployment Configuration
APP_NAME="App_sample"
# One of: local|development|production
APP_ENVIRONMENT="development"
APP_TIMEZONE="America/Belize"

# Database Configuration
# Host defaults, so `cargo run` and the tests work against the published port.
# Compose overrides DB_HOST and MAIL_HOST for the containerised app.
DB_HOST="127.0.0.1"
DB_PORT=5432
DB_DATABASE="api_starter"
DB_USERNAME="postgres"
DB_PASSWORD="password"
DB_MAX_CONNECTIONS=10
# Apply the embedded migrations on start up.
DB_RUN_MIGRATIONS=true

# Mailer Configuration
MAIL_HOST="127.0.0.1"
MAIL_PORT=1025
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="API Starter"

# JWT Configuration
JWT_SECRET="secret"

# Authentication Configuration
AUTHENTICATION_ACCESS_TOKEN_TTL_SECONDS=3600
AUTHENTICATION_REFRESH_TOKEN_TTL_SECONDS=604800

# Logger Configuration
# One of: trace|debug|info|warn|error
LOGGER_LEVEL=info
LOGGER_DIRECTORY="storage/logs"
