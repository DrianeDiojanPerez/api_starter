meta {
  name: Forgot Password
  type: http
  seq: 3
}

post {
  url: {{url}}/v1/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "callback_uri": "http://localhost:4321/reset-password/"
  }
}

assert {
  res.status: eq 200
}

docs {
  Mails a reset link built from `callback_uri` plus the raw token.

  Only the SHA-256 digest of that token is stored, so read the token from the
  mail itself. In development Mailhog serves it on http://localhost:8025 and
  the raw value goes in the `reset_token` environment variable.
}
