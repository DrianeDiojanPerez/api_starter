meta {
  name: Reset Password
  type: http
  seq: 4
}

post {
  url: {{url}}/v1/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "{{reset_token}}",
    "password": "N3wP@ssword"
  }
}

docs {
  Consumes the token mailed by `Forgot Password`. The token is single use and
  expires 15 minutes after it was requested.

  Set `reset_token` on the environment first.
}
